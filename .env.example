# ── Binance Web3 API (https://web3.binance.com/en/dev-portal) ─────────────
# Without these, FairFill runs in PREVIEW mode: keyless public catalog data,
# indicative prices only, no quotes, no execution.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=

# Wallet address used for RFQ quotes (Ondo, bStocks RFQ) when no wallet is
# connected. The Trading API requires userWalletAddress for RFQ routes.
# Read-only use: nothing is ever signed with it.
FAIRFILL_QUOTE_WALLET=

# Public URL of this deployment (used in x402 resource URLs and receipts).
FAIRFILL_BASE_URL=http://localhost:3000

# ── Paid route endpoint for agents (x402 v2, settled by B402) ────────────
# payTo is WRITE-ONCE in the Developer Portal: set it to the address you
# configured during B402 onboarding. Leave empty to disable /api/x402/route.
FAIRFILL_X402_PAY_TO=
FAIRFILL_X402_PRICE_USD=0.01
# U on BSC supports EIP-3009 (no approval needed by the buyer).
FAIRFILL_X402_ASSET=0xcE24439F2D9C6a2289F741120FE202248B666666

# ── Engine tuning ──────────────────────────────────────────────────────────
# Below this 24h on-chain turnover a displayed price is treated as stale.
FAIRFILL_MIN_ONCHAIN_VOLUME_USD=1000
# Routes whose quoted price impact exceeds this are rejected.
FAIRFILL_MAX_PRICE_IMPACT_PCT=3

# ── Developer Experience journal (records latency + exact error messages) ─
FAIRFILL_JOURNAL=on
FAIRFILL_JOURNAL_DIR=.dx-journal

# ── Browser wallet execution (client side) ────────────────────────────────
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# ── MCP server / Agent Studio tools in remote mode ───────────────────────
# When set, the MCP server calls this FairFill deployment instead of
# running the engine locally.
FAIRFILL_API_URL=
